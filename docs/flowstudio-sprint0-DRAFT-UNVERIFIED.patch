+// ============================================================================
+// Project IR - Intermediate Representation
+// ============================================================================
+
+export interface ProjectIR {
+  id: string;
+  title: string;
+  description?: string;
+  goal: 'awareness' | 'consideration' | 'conversion';
+  tone: 'warm' | 'professional' | 'energetic';
+  sequences: SequenceIR[];
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface SequenceIR {
+  id: string;
+  projectId: string;
+  number: number;
+  title?: string;
+  description?: string;
+  shots: ShotIR[];
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface ShotIR {
+  id: string;
+  sequenceId: string;
+  number: number;
+  description: string;
+  duration: number; // seconds
+  notes?: string;
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+// ============================================================================
+// Brief IR - Structured output from LLM analysis
+// ============================================================================
+
+export interface BriefIR {
+  id: string;
+  projectId: string;
+  title: string;
+  mainMessage: string;
+  shotList: ShotBriefIR[];
+  totalDuration: number; // seconds
+  createdAt: Date;
+  updatedAt: Date;
+}
+
+export interface ShotBriefIR {
+  shot: number;
+  description: string;
+  duration: number; // seconds
+  notes?: string;
+  cameraMovement?: string;
+  suggestions?: string[];
+}
+
+// ============================================================================
+// Generation IR - LLM Prompt and Response
+// ============================================================================
+
+export interface GenerationIR {
+  id: string;
+  shotId: string;
+  userId: string;
+  modelId: string;
+  modality: 'TEXT' | 'IMAGE' | 'VIDEO' | 'AUDIO';
+
+  // Prompt & Parameters
+  prompt: string;
+  seed?: number;
+  paramHash: string;
+  parameters: Record<string, unknown>;
+
+  // Results
+  resultUrl?: string;
+  resultHash?: string;
+  resultMetadata?: Record<string, unknown>;
+
+  // Cost & Status
+  costEstimated: number;
+  costActual?: number;
+  status: 'PENDING' | 'PROCESSING' | 'COMPLETED' | 'FAILED';
+  errorMessage?: string;
+
+  // Approval
+  humanApproval?: boolean;
+  humanReasonCode?: string;
+
+  // Metadata
+  c2paMetadata?: Record<string, unknown>;
+  createdAt: Date;
+  completedAt?: Date;
+}
+
+// ============================================================================
+// API Request/Response DTOs
+// ============================================================================
+
+export interface CreateProjectRequest {
+  title: string;
+  description?: string;
+  goal: 'awareness' | 'consideration' | 'conversion';
+  tone: 'warm' | 'professional' | 'energetic';
+}
+
+export interface CreateBriefRequest {
+  projectId: string;
+  idea: string;
+}
+
+export interface GenerateImageRequest {
+  shotId: string;
+  seed?: number;
+  duration?: number;
+  aspectRatio?: '9:16' | '16:9' | '1:1';
+}
+
+export interface GenerateVideoRequest {
+  shotId: string;
+  frameUrl: string;
+  seed?: number;
+  duration: number;
+  aspectRatio?: '9:16' | '16:9';
+  cameraControlLevel?: 'BASIC' | 'ADVANCED';
+}
+
+// ============================================================================
+// Model Registry IR
+// ============================================================================
+
+export type Modality = 'TEXT' | 'IMAGE' | 'VIDEO' | 'AUDIO';
+export type RegionReachable = 'IRAN' | 'HETZNER' | 'BOTH';
+
+export interface ModelRegistryIR {
+  modelKey: string;
+  modality: Modality;
+  displayName?: string;
+  maxDurationSec?: number;
+  acceptsSeed: boolean;
+  cameraControl: 'NONE' | 'BASIC' | 'ADVANCED';
+  commercialUse: boolean;
+  regionReachable: RegionReachable;
+  costPerUnit: number;
+  isActive: boolean;
+}
+
+export interface ProviderRegistryIR {
+  name: string;
+  baseUrl: string;
+  apiKey: string;
+  isActive: boolean;
+  priority: number;
+  regionReachable: RegionReachable;
+  models: ModelRegistryIR[];
+}
