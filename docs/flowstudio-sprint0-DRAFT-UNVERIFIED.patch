diff --git a/apps/api/prisma/schema.prisma b/apps/api/prisma/schema.prisma
new file mode 100644
index 0000000..c300b64
--- /dev/null
+++ b/apps/api/prisma/schema.prisma
@@ -0,0 +1,262 @@
+generator client {
+  provider = "prisma-client-js"
+}
+
+datasource db {
+  provider = "postgresql"
+  url      = env("DATABASE_URL")
+}
+
+// ============================================================================
+// AUTH MODELS
+// ============================================================================
+
+model User {
+  id              String      @id @default(cuid())
+  phone           String      @unique
+  email           String?     @unique
+  passwordHash    String?
+  siteId          String?
+
+  profile         UserProfile?
+  wallet          Wallet?
+  projects        Project[]
+  generations     Generation[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+}
+
+model UserProfile {
+  id              String      @id @default(cuid())
+  userId          String      @unique
+  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  firstName       String?
+  lastName        String?
+  avatar          String?
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+}
+
+// ============================================================================
+// PROJECT & CONTENT MODELS
+// ============================================================================
+
+model Project {
+  id              String      @id @default(cuid())
+  userId          String
+  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  title           String
+  description     String?
+  goal            String      // awareness / consideration / conversion
+  tone            String      // warm / professional / energetic
+  status          String      @default("draft") // draft / in-progress / completed
+
+  sequences       Sequence[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@index([userId])
+}
+
+model Sequence {
+  id              String      @id @default(cuid())
+  projectId       String
+  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
+
+  number          Int
+  title           String?
+  description     String?
+
+  shots           Shot[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@unique([projectId, number])
+  @@index([projectId])
+}
+
+model Shot {
+  id              String      @id @default(cuid())
+  sequenceId      String
+  sequence        Sequence    @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
+
+  number          Int
+  description     String
+  duration        Int         // seconds
+  notes           String?
+
+  generations     Generation[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@unique([sequenceId, number])
+  @@index([sequenceId])
+}
+
+// ============================================================================
+// AI PROVIDER MODELS
+// ============================================================================
+
+model AiProvider {
+  id              String      @id @default(cuid())
+  name            String      @unique
+  baseUrl         String
+  apiKey          String      @db.Text
+
+  isActive        Boolean     @default(true)
+  priority        Int         @default(100)
+  regionReachable String      @default("IRAN") // IRAN / HETZNER / BOTH
+
+  models          AiModel[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+}
+
+model AiModel {
+  id              String      @id @default(cuid())
+  providerId      String
+  provider        AiProvider  @relation(fields: [providerId], references: [id], onDelete: Cascade)
+
+  modelKey        String
+  modality        String      // TEXT / IMAGE / VIDEO / AUDIO
+
+  displayName     String?
+  maxDurationSec  Int?
+  acceptsSeed     Boolean     @default(false)
+  cameraControl   String      @default("NONE") // NONE / BASIC / ADVANCED
+  commercialUse   Boolean     @default(true)
+
+  costPerUnit     Float
+
+  isActive        Boolean     @default(true)
+
+  generations     Generation[]
+
+  @@unique([providerId, modelKey, modality])
+  @@index([providerId])
+}
+
+// ============================================================================
+// LEDGER & GENERATION MODELS
+// ============================================================================
+
+model Generation {
+  id              String      @id @default(cuid())
+  shotId          String
+  shot            Shot        @relation(fields: [shotId], references: [id], onDelete: Cascade)
+
+  userId          String
+  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  modelId         String
+  model           AiModel     @relation(fields: [modelId], references: [id])
+
+  prompt          String      @db.Text
+  seed            Int?
+  paramHash       String
+
+  result          Bytes?
+  resultHash      String?
+  resultUrl       String?
+
+  costEstimated   Float
+  costActual      Float?
+
+  humanApproval   Boolean?
+  humanReasonCode String?
+
+  c2paMetadata    Json?
+
+  jobId           String?
+  job             Job?
+
+  status          String      @default("PENDING") // PENDING / PROCESSING / COMPLETED / FAILED
+  errorMessage    String?
+
+  createdAt       DateTime    @default(now())
+  completedAt     DateTime?
+  updatedAt       DateTime    @updatedAt
+
+  @@index([shotId])
+  @@index([userId])
+  @@index([modelId])
+  @@index([status])
+}
+
+// ============================================================================
+// WALLET & BILLING MODELS
+// ============================================================================
+
+model Wallet {
+  id              String      @id @default(cuid())
+  userId          String      @unique
+  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
+
+  balance         Int         @default(0) // in smallest unit (تومان)
+  holdAmount      Int         @default(0)
+
+  monthlyCap      Int?        // monthly spending limit
+  monthlyUsed     Int         @default(0)
+
+  transactions    Transaction[]
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@index([userId])
+}
+
+model Transaction {
+  id              String      @id @default(cuid())
+  walletId        String
+  wallet          Wallet      @relation(fields: [walletId], references: [id], onDelete: Cascade)
+
+  type            String      // HOLD / SETTLE / RELEASE / DEPOSIT / REFUND
+  amount          Int
+  description     String?
+
+  generationId    String?
+  reference       String?
+
+  createdAt       DateTime    @default(now())
+
+  @@index([walletId])
+  @@index([type])
+}
+
+// ============================================================================
+// JOB QUEUE MODELS
+// ============================================================================
+
+model Job {
+  id              String      @id @default(cuid())
+  generationId    String      @unique
+  generation      Generation  @relation(fields: [generationId], references: [id], onDelete: Cascade)
+
+  status          String      @default("PENDING") // PENDING / PROCESSING / COMPLETED / FAILED
+
+  attempt         Int         @default(0)
+  maxAttempts     Int         @default(3)
+
+  errorMessage    String?
+  errorCode       String?
+
+  metadata        Json?
+
+  startedAt       DateTime?
+  completedAt     DateTime?
+
+  createdAt       DateTime    @default(now())
+  updatedAt       DateTime    @updatedAt
+
+  @@index([status])
+  @@index([createdAt])
+}
