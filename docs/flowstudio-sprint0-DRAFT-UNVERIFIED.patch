+│       ├── .env.local
+│       └── .gitignore
+├── packages/
+│   ├── ir/                # Intermediate Representation types
+│   │   ├── src/
+│   │   │   └── index.ts
+│   │   ├── package.json
+│   │   └── tsconfig.json
