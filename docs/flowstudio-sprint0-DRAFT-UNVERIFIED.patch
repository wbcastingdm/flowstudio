+// ============================================================================
+// Model Contracts - Shared interfaces for all models
+// ============================================================================
+
+export enum Modality {
+  TEXT = 'TEXT',
+  IMAGE = 'IMAGE',
+  VIDEO = 'VIDEO',
+  AUDIO = 'AUDIO',
+}
+
+export enum CameraControl {
+  NONE = 'NONE',
+  BASIC = 'BASIC',
+  ADVANCED = 'ADVANCED',
+}
+
+export enum RegionReachable {
+  IRAN = 'IRAN',
+  HETZNER = 'HETZNER',
+  BOTH = 'BOTH',
+}
+
+// ============================================================================
+// Base Model Contract
+// ============================================================================
+
+export interface BaseModelContract {
+  modelKey: string;
+  modality: Modality;
+  displayName?: string;
+  isActive: boolean;
+  commercialUse: boolean;
+  costPerUnit: number;
+}
+
+// ============================================================================
+// Text Model Contract
+// ============================================================================
+
+export interface TextModelContract extends BaseModelContract {
+  modality: Modality.TEXT;
+  maxTokens?: number;
+  temperature?: number;
+}
+
+// ============================================================================
+// Image Model Contract
+// ============================================================================
+
+export interface ImageModelContract extends BaseModelContract {
+  modality: Modality.IMAGE;
+  supportedResolutions: Array<{
+    width: number;
+    height: number;
+  }>;
+  acceptsSeed: boolean;
+  maxPromptLength?: number;
+}
+
+// ============================================================================
+// Video Model Contract
+// ============================================================================
+
+export interface VideoModelContract extends BaseModelContract {
+  modality: Modality.VIDEO;
+  maxDurationSec: number;
+  acceptsSeed: boolean;
+  cameraControl: CameraControl;
+  supportedResolutions: Array<{
+    width: number;
+    height: number;
+  }>;
+  maxPromptLength?: number;
+  requiresKeyFrame: boolean;
+}
+
+// ============================================================================
+// Provider Contract
+// ============================================================================
+
+export interface ProviderContract {
+  providerId: string;
+  name: string;
+  baseUrl: string;
+  apiKey: string;
+  isActive: boolean;
+  priority: number;
+  regionReachable: RegionReachable;
+  healthCheck?: {
+    endpoint: string;
+    interval: number; // ms
+    timeout: number; // ms
+  };
+}
+
+// ============================================================================
+// Model Registry
+// ============================================================================
+
+export interface ModelRegistry {
+  [key: string]: BaseModelContract | TextModelContract | ImageModelContract | VideoModelContract;
+}
+
+// ============================================================================
+// Adapter Contracts - What each adapter must implement
+// ============================================================================
+
+export interface GenerationRequest {
+  prompt: string;
+  seed?: number;
+  parameters?: Record<string, unknown>;
+  metadata?: Record<string, unknown>;
+}
+
+export interface GenerationResponse {
+  jobId?: string;
+  result?: string | Buffer;
+  resultUrl?: string;
+  status: 'COMPLETED' | 'PENDING' | 'FAILED';
+  error?: string;
+  metadata?: Record<string, unknown>;
+}
+
+export interface ModelAdapter {
+  modelKey: string;
+  modality: Modality;
+
+  // Submit a generation job
+  submit(request: GenerationRequest): Promise<GenerationResponse>;
+
+  // Poll job status (for async models)
+  poll?(jobId: string): Promise<GenerationResponse>;
+
+  // Get model capabilities
+  getCapabilities(): BaseModelContract;
+
+  // Health check
+  healthCheck?(): Promise<boolean>;
+}
