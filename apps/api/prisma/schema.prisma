// FlowStudio — شِمای دیتابیس، اسپرینتِ ۰
// تصمیم‌های بسته‌شده که این فایل را شکل داده‌اند (docs/20):
//   D-005 واحدِ پول = سکه   ·   D-007 صف = جدولِ Job + قفلِ دیتابیسی
//   D-008 احرازِ هویت = موبایل+OTP   ·   D-010 C2PA = واترمارکِ متنی
// الزاماتِ طول‌آگاهی (docs/40 بندِ ۳): Project→Sequence→Shot، continuityRef
// رزروشده، JobGroup از روزِ اول.

generator client {
  provider      = "prisma-client-js"
  // ⚠️ روی مک native کافی است، ولی ایمیجِ alpine (musl) با OpenSSL 3 است.
  // بدونِ این، کانتینر با «libssl.so.1.1: No such file» کرش می‌کند —
  // و این خطا فقط داخلِ داکر دیده می‌شود، نه روی مک.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── کاربر و کیف‌پول (D-008, D-005) ───

model User {
  id           String    @id @default(cuid())
  phone        String    @unique
  otpCodeHash  String?
  otpExpiresAt DateTime?
  otpAttempts  Int       @default(0)
  /// قراردادِ جدایش (سندِ ۸۱ بخشِ ۱۲): هویت مالِ FlowStudio است.
  /// SSOِ وبکستینگ فقط **یک provider** خواهد بود، نه صاحبِ کاربر —
  /// روزِ مهاجرت یک ردیفِ تازه اضافه می‌شود، نه بازسازیِ هویت.
  authProvider String    @default("otp") // otp | webcasting_sso | ...
  externalId   String?

  /// نام نمایشی روی سایت عمومی.
  ///
  /// 🔒 بدون این فیلد، تنها شناسه انسانی کاربر شماره موبایلش است — و شماره
  /// موبایل هرگز نباید در صفحه عمومی اثر یا پروفایل سازنده دیده شود. تا
  /// وقتی کاربر نامی انتخاب نکرده، «سازنده ناشناس» نشان داده می‌شود.
  displayName  String?
  bio          String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  wallet         Wallet?
  projects       Project[]
  jobGroups      JobGroup[]
  assets         Asset[]
  termsAccepted  TermsAcceptance[]
  castingProfile CastingProfile?
  comments       Comment[]

  @@unique([authProvider, externalId])
}

model Wallet {
  id      String @id @default(cuid())
  userId  String @unique
  user    User   @relation(fields: [userId], references: [id])
  /// سکهٔ **قابلِ خرج‌کردن**. مبلغِ رزروشده از همین کسر شده و در `held` است،
  /// پس `balance` هرگز شاملِ پولی که جای دیگری قول داده شده نیست.
  balance Int    @default(0)
  /// سکهٔ رزروشده و هنوز خرج‌نشده. مجموعِ `balance + held` داراییِ کاربر است.
  held    Int    @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  holds   WalletHold[]
  entries WalletEntry[]
}

/// وضعیتِ یک رزرو. از `HELD` فقط یک بار خارج می‌شود — یا خرج شد یا برگشت.
enum HoldStatus {
  HELD
  SETTLED
  RELEASED
}

/// گاردریلِ ۶ منشورِ اجرا: **`hold` قبل از خرج، `release` در `catch`**.
/// بدونِ این جدول، شکستِ یک فراخوانِ پولی یعنی سکهٔ گم‌شده: کسر شده ولی
/// هیچ خروجی‌ای در برابرش نیست و هیچ ردی هم از برگشتش نمانده.
model WalletHold {
  id            String     @id @default(cuid())
  walletId      String
  wallet        Wallet     @relation(fields: [walletId], references: [id])
  jobGroupId    String?
  jobGroup      JobGroup?  @relation(fields: [jobGroupId], references: [id])
  /// مبلغِ رزروشده — سقفِ خرج. تسویه هرگز از این بیشتر نمی‌شود.
  amount        Int
  /// مبلغِ واقعیِ خرج‌شده. تفاوتش با `amount` به `balance` برمی‌گردد.
  settledAmount Int?
  status        HoldStatus @default(HELD)
  /// برایِ چه رزرو شد — متنِ کوتاهِ قابلِ خواندن در دفتر.
  purpose       String
  createdAt     DateTime   @default(now())
  resolvedAt    DateTime?

  entries WalletEntry[]

  @@index([walletId, status])
  @@index([jobGroupId])
}

enum WalletEntryType {
  CREDIT
  HOLD
  SETTLE
  RELEASE
}

/// دفترِ ثبتِ **غیرقابلِ‌تغییر**. `Wallet.balance` فقط یک خلاصهٔ سریع است؛
/// حقیقت این‌جاست و باید همیشه با آن جمع بخورد. هیچ ردیفی UPDATE نمی‌شود.
model WalletEntry {
  id           String          @id @default(cuid())
  walletId     String
  wallet       Wallet          @relation(fields: [walletId], references: [id])
  type         WalletEntryType
  /// همیشه **مثبت** — جهت را `type` تعیین می‌کند، نه علامتِ عدد.
  amount       Int
  /// عکسِ لحظه‌ایِ کیفِ پول بعد از این ردیف — تا ممیزی به بازپخشِ کلِ دفتر
  /// نیاز نداشته باشد.
  balanceAfter Int
  heldAfter    Int

  holdId       String?
  hold         WalletHold? @relation(fields: [holdId], references: [id])
  generationId String?
  note         String?
  createdAt    DateTime    @default(now())

  @@index([walletId, createdAt])
  @@index([holdId])
}

// ═══ رجیستری محصول — نوع تولید، سطح خدمت، مجوز، کاتالوگ ═══
//
// قاعده حاکم این بخش: هر چیزی که ممکن است فردا عوض شود **ردیف داده** است،
// نه enum و نه ثابت در کد. افزودن یک نوع تولید تازه، یک سطح خدمت تازه یا یک
// نوع مجوز تازه هیچ مهاجرتی نمی‌خواهد.

/// نوع تولید: تبلیغی، فیلم کوتاه، مستند، انیمیشن، موزیک ویدیو، آموزشی.
///
/// `fieldSchema` همان چیزی است که فرم **بعد از** انتخاب نوع می‌پرسد — چون
/// زیرشاخه‌ها به نوع وابسته‌اند: لحن فقط برای تبلیغ معنا دارد و برای فیلم
/// کوتاه جایش را ژانر می‌گیرد. نگه داشتن این در ستون Json یعنی نوع تازه یا
/// فیلد تازه فقط یک ردیف است.
model ProductionType {
  id             String  @id @default(cuid())
  key            String  @unique
  title          String
  description    String?
  minDurationSec Int
  maxDurationSec Int
  /// آرایه‌ای از { key, label, kind, options?, required } — قرارداد فرم.
  fieldSchema    Json
  /// راهنمای لحن پرامپت برای این نوع؛ به موتور پرامپت داده می‌شود.
  promptGuide    String
  orderIndex     Int     @default(0)
  /// انتخاب نوع‌های نسخه اول یک **تنظیم** است، نه یک استقرار تازه.
  isActive       Boolean @default(false)

  projects Project[]
}

/// جنس تصویر. `materialFidelity` درجه نزدیکی به آن جنس است (۰ تا ۱۰۰).
enum MaterialStyle {
  REAL
  ANIME
  COMIC
  FANTASY
  THREE_D
  STOP_MOTION
}

/// سطح خدمت — برنزی، نقره‌ای، طلایی.
///
/// 🔑 نکته طراحی: سطح با **سیاست** تعریف می‌شود نه با فهرست شناسه مدل.
/// «مدل‌های اقتصادی» یعنی `maxCostPerUnit`، نه ده شناسه که با افزودن مدل
/// یازدهم کهنه می‌شود. با این کار رجیستری مدل و سطوح خدمت مستقل می‌مانند.
model ServiceTier {
  id               String   @id @default(cuid())
  key              String   @unique
  title            String
  orderIndex       Int      @default(0)
  /// سقف سکه هر پاکت بودجه در این سطح.
  coinAllowance    Int
  maxDurationSec   Int
  /// سقف هزینه هر واحد. null یعنی بی‌سقف (فقط برای بالاترین سطح).
  maxCostPerUnit   Int?
  /// گام‌های مجاز از تاکسونومی بسته. خالی یعنی همه.
  allowedStepTypes String[] @default([])
  watermark        Boolean  @default(true)
  queuePriority    Int      @default(0)
  /// آیا اثر این سطح پیش از انتشار بازبینی انسانی می‌شود.
  humanReview      Boolean  @default(false)
  /// قیمت فروش. **عمدا null است** تا پیش از اندازه‌گیری هزینه واقعی،
  /// عددی اختراع نشود (D-204).
  priceIrt         Int?
  isActive         Boolean  @default(true)

  projects Project[]
}

/// پرونده مجوز — پاسخ به «رایگان یک چیز نیست، چهار چیز است».
///
/// `allowedTargets` تعیین می‌کند اثری که از این مجوز استفاده کرده، در کدام
/// مقصدها قابل انتشار است. ترکی که برای دانلود شخصی آزاد است ممکن است برای
/// انتشار روی فلک آزاد نباشد؛ سیستم این را می‌داند و فیلتر می‌کند.
model MediaLicense {
  id                  String              @id @default(cuid())
  code                String              @unique
  title               String
  /// خلاصه شرط به زبان ساده — همین متن کنار هر آیتم به کاربر نشان داده می‌شود.
  userFacingSummary   String
  commercialUse       Boolean
  attributionRequired Boolean
  attributionTemplate String?
  /// مقصدهای مجاز. خالی یعنی همه مقصدها.
  allowedTargets      PublicationTarget[] @default([])
  sourceUrl           String?
  notes               String?

  catalogItems MediaCatalogItem[]
  assets       Asset[]
}

/// کاتالوگ موسیقی و المان تصویری. `priceCoins = 0` یعنی رایگان — ولی
/// «رایگان» بدون `licenseId` بی‌معناست، پس مجوز اجباری است.
model MediaCatalogItem {
  id          String       @id @default(cuid())
  kind        String // music | sfx | background | overlay | font | template
  title       String
  genres      String[]     @default([])
  moods       String[]     @default([])
  durationSec Int?
  previewUrl  String?
  storageKey  String?
  licenseId   String
  license     MediaLicense @relation(fields: [licenseId], references: [id])
  priceCoins  Int          @default(0)
  sourceName  String
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  @@index([kind, isActive])
}

// ═══ دارایی — لایه ۱ معماری ═══

enum AssetKind {
  TEXT
  IMAGE
  CLIP
  AUDIO
}

/// هر ورودی و هر خروجی یک دارایی شناسنامه‌دار است.
///
/// `role` می‌گوید این دارایی چه کاره است؛ `kind` می‌گوید چه جنسی دارد. جدا
/// نگه داشتنشان لازم است: یک عکس هم می‌تواند مرجع سبک باشد هم چهره کاربر.
model Asset {
  id            String        @id @default(cuid())
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  projectId     String?
  project       Project?      @relation(fields: [projectId], references: [id])
  kind          AssetKind
  /// input_script | reference_image | face | base_clip | music |
  /// shot_output | final_output
  role          String
  storageKey    String
  mimeType      String
  byteSize      Int
  sha256        String
  durationSec   Int?
  width         Int?
  height        Int?
  /// متن استخراج‌شده از فایل متنی — تا لایه فهم دوباره فایل را باز نکند.
  extractedText String?
  licenseId     String?
  license       MediaLicense? @relation(fields: [licenseId], references: [id])
  createdAt     DateTime      @default(now())

  publications Publication[]

  @@index([userId, kind])
  @@index([projectId, role])
  @@index([sha256])
}

// ═══ حقوقی و انطباق ═══

/// متن نسخه‌دار. نسخه تازه ردیف تازه است، نه ویرایش ردیف قبلی — وگرنه
/// نمی‌شود ثابت کرد کاربر کدام متن را پذیرفته بود.
model TermsDocument {
  id          String    @id @default(cuid())
  /// terms | free_content_rules | face_consent | privacy
  slug        String
  version     Int
  title       String
  body        String
  publishedAt DateTime?

  acceptances TermsAcceptance[]

  @@unique([slug, version])
}

model TermsAcceptance {
  id         String        @id @default(cuid())
  userId     String
  user       User          @relation(fields: [userId], references: [id])
  documentId String
  document   TermsDocument @relation(fields: [documentId], references: [id])
  acceptedAt DateTime      @default(now())
  /// هش نشانی، نه خود نشانی — برای اثبات کافی است و داده شخصی کمتری نگه می‌دارد.
  ipHash     String?

  @@unique([userId, documentId])
  @@index([userId])
}

enum ComplianceStage {
  PRE_PRODUCTION
  PRE_PUBLICATION
}

enum ComplianceStatus {
  PENDING
  AUTO_PASSED
  AUTO_FLAGGED
  APPROVED
  REJECTED
}

/// دروازه بازبینی. دو ایستگاه دارد و هر دو از یک جدول می‌آیند: یکی پیش از
/// خرج پول، یکی پیش از انتشار.
model ComplianceCheck {
  id           String           @id @default(cuid())
  projectId    String
  project      Project          @relation(fields: [projectId], references: [id])
  stage        ComplianceStage
  status       ComplianceStatus @default(PENDING)
  /// خروجی خام بررسی خودکار — تا تصمیم ماشین قابل بازبینی بماند.
  autoVerdict  Json?
  reasonCodeId String?
  reasonCode   ReasonCode?      @relation(fields: [reasonCodeId], references: [id])
  reviewerNote String?
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())

  @@unique([projectId, stage])
  @@index([status, stage])
}

// ═══ انتشار — لایه ۵ معماری ═══

enum PublicationTarget {
  DOWNLOAD
  PUBLIC_SITE
  FALAK_VIDEO
  FALAK_STORY
  EXTERNAL_LINK
}

enum PublicationStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  WITHDRAWN
  FAILED
}

/// یک اثر، چند رکورد نمایش — نه چند نسخه از فایل.
///
/// کلید یکتا روی (پروژه، مقصد) یعنی یک اثر در هر مقصد فقط یک بار می‌نشیند،
/// و برداشتنش از پنل راهبر یک UPDATE است نه شکار در چند سامانه.
model Publication {
  id           String            @id @default(cuid())
  projectId    String
  project      Project           @relation(fields: [projectId], references: [id])
  assetId      String?
  asset        Asset?            @relation(fields: [assetId], references: [id])
  target       PublicationTarget
  status       PublicationStatus @default(DRAFT)
  externalUrl  String?
  externalId   String?
  /// شمارنده ساده بازدید. تحلیل دقیق کار ابزار جداست؛ این فقط برای
  /// مرتب‌سازی «پربازدیدها» در صفحه کشف است.
  viewCount    Int               @default(0)
  publishedAt  DateTime?
  withdrawnAt  DateTime?
  withdrawnBy  String?
  reasonCodeId String?
  reasonCode   ReasonCode?       @relation(fields: [reasonCodeId], references: [id])
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@unique([projectId, target])
  @@index([status])
}

enum CommentStatus {
  PENDING
  APPROVED
  REJECTED
  HIDDEN
}

/// دیدگاه روی اثر عمومی.
///
/// وضعیت پیش‌فرض `PENDING` نیست بلکه از تنظیم سایت می‌آید — ولی هر حالتی
/// که باشد، راهبر حق برداشتن دارد. `HIDDEN` با `REJECTED` فرق دارد:
/// اولی تصمیم راهبر است، دومی نتیجه بررسی خودکار.
model Comment {
  id           String        @id @default(cuid())
  projectId    String
  project      Project       @relation(fields: [projectId], references: [id])
  userId       String
  user         User          @relation(fields: [userId], references: [id])
  body         String
  status       CommentStatus @default(APPROVED)
  reasonCodeId String?
  reasonCode   ReasonCode?   @relation(fields: [reasonCodeId], references: [id])
  moderatedBy  String?
  moderatedAt  DateTime?
  createdAt    DateTime      @default(now())

  @@index([projectId, status, createdAt])
  @@index([status])
}

/// شاخه بازیگر — بدون رضایت ثبت‌شده هیچ گام چهره اجرا نمی‌شود.
model CastingProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id])
  consentVersion    Int?
  consentAcceptedAt DateTime?
  faceAssetIds      String[]  @default([])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// ─── محتوا: پروژه → سکانس → شات — طول‌آگاه از روزِ اول ───

/// ⚠️ منسوخ — جایش را `ProductionType` گرفت. برای ردیف‌های موجود می‌ماند.
enum CampaignGoal {
  BRAND_AWARENESS
  ORDER_CAPTURE
  PRODUCT_INTRO
}

enum Tone {
  WARM_FRIENDLY
  PROFESSIONAL
  ENERGETIC
}

model Project {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])
  title  String

  /// ⚠️ منسوخ — فقط برای ردیف‌های ساخته‌شده پیش از رجیستری نوع تولید.
  goal CampaignGoal?
  tone Tone?

  productionTypeId String?
  productionType   ProductionType? @relation(fields: [productionTypeId], references: [id])
  /// پاسخ کاربر به زیرشاخه‌های همان نوع، طبق `fieldSchema`. اعتبارسنجی در
  /// سرویس انجام می‌شود، نه در پایگاه داده — چون شما به نوع وابسته است.
  attributes       Json?

  materialStyle     MaterialStyle?
  /// درجه نزدیکی به آن جنس، ۰ تا ۱۰۰.
  materialFidelity  Int?           @default(70)
  /// مدت هدف به ثانیه. تا ساعت هم می‌رود — ۳۶۰۰ و بیشتر مجاز است.
  targetDurationSec Int?

  serviceTierId String?
  serviceTier   ServiceTier? @relation(fields: [serviceTierId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sequences        Sequence[]
  assets           Asset[]
  publications     Publication[]
  complianceChecks ComplianceCheck[]
  comments         Comment[]

  @@index([userId])
  @@index([productionTypeId])
}

model Sequence {
  id        String  @id @default(cuid())
  projectId String
  project   Project @relation(fields: [projectId], references: [id])
  order     Int
  title     String

  shots Shot[]

  @@index([projectId])
}

enum AspectRatio {
  R9_16
  R16_9
  R1_1
}

enum CameraMovement {
  STATIC
  PAN
  TILT
  DOLLY
  HANDHELD
  COMBINED
}

enum ShotStatus {
  DRAFT
  QUEUED
  GENERATING
  DONE
  REJECTED
}

model Shot {
  id             String         @id @default(cuid())
  sequenceId     String
  sequence       Sequence       @relation(fields: [sequenceId], references: [id])
  order          Int
  durationSec    Int
  /// تنها فیلدِ متنِ آزادِ مجاز در این سطح (گاردریلِ منشورِ اجرا).
  description    String
  cameraMovement CameraMovement
  aspectRatio    AspectRatio
  seed           Int?
  /// رزروشده برایِ پیوستگیِ شخصیت/لوکیشن/پراپ — فازِ ۱ همیشه null، حذف نشود.
  continuityRef  Json?
  status         ShotStatus     @default(DRAFT)
  /// L2ِ سندِ ۸۱ — سهمِ این نما از پاکتِ بودجه. نمای قهرمان و نمای پرکننده
  /// سهمِ برابر نمی‌گیرند. پیش‌فرض ۱۰۰ یعنی «معمولی».
  weight         Int            @default(100)

  jobs        Job[]
  generations Generation[]
  planSteps   PlanStep[]
  direction   SceneDirection?

  @@index([sequenceId])
}

/// چه کسی این تصمیم کارگردانی را گرفت.
enum DirectionOrigin {
  USER
  MACHINE
}

/// عمق کارگردانی هر نما: میزان‌سن، حرکت دوربین، اندازه و زاویه نما، نور.
///
/// 🔑 `origins` برای هر فیلد می‌گوید نوشته کاربر است یا پیشنهاد ماشین.
/// تفکیک‌پذیر ماندن این دو دو فایده دارد: کاربر می‌بیند ماشین چه اضافه کرده،
/// و بعدا می‌شود سنجید کدام پیشنهادها واقعا خروجی بهتری دادند.
model SceneDirection {
  id     String @id @default(cuid())
  shotId String @unique
  shot   Shot   @relation(fields: [shotId], references: [id])

  miseEnScene    String?
  cameraMovement String?
  shotSize       String?
  cameraAngle    String?
  lighting       String?
  colorMood      String?

  /// { fieldName: "USER" | "MACHINE" }
  origins            Json
  /// پیشنهادهایی که ماشین داد و کاربر هنوز درباره‌شان تصمیم نگرفته.
  pendingSuggestions Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── لایهٔ درگاهِ AI — رجیستری (اسپرینتِ ۱ از این می‌خواند) ───

enum Modality {
  TEXT
  IMAGE
  AUDIO
  VIDEO
}

model AiProvider {
  id              String   @id @default(cuid())
  name            String   @unique
  baseUrl         String
  /// هرگز متنِ خام — رمزنگاری‌شده در سطحِ سرویس (الگویِ BYOKِ وبکستینگ).
  apiKeyEncrypted String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  models AiModel[]
  calls  ProviderCall[]
}

model AiModel {
  id              String     @id @default(cuid())
  providerId      String
  provider        AiProvider @relation(fields: [providerId], references: [id])
  modelKey        String
  modality        Modality
  costPerUnit     Int // سکه
  /// قراردادِ قابلیت — همهٔ پنج فیلد اجباری (docs/00 بندِ ۲-۸).
  maxDurationSec  Int? // فقط برایِ VIDEO؛ برایِ TEXT/IMAGE null
  acceptsSeed     Boolean
  cameraControl   String // NONE | BASIC | FULL
  commercialUse   Boolean
  regionReachable String // IRAN | HETZNER | BOTH

  // ─── افزوده‌های سندِ ۸۱ ───
  /// D-O15: فیلترِ ریزِ L3. `modality` فیلترِ درشت می‌ماند و اگر این خالی
  /// بود روتر به همان می‌افتد — پس ردیف‌های قدیمی نمی‌شکنند.
  stepTypes         String[] @default([])
  /// D-O14: تنها فیلدِ Decimal — قیمتِ فهرستیِ خامِ درگاه، برایِ گزارش و
  /// ورودیِ CPAS. **هرگز مبنایِ کسر از کیفِ پول نیست** (آن `costPerUnit`ِ
  /// سکه‌ای است) و **هرگز مبنایِ انتخاب هم نیست** — انتخاب با CPAS است.
  listPricePerUnit  Decimal? @db.Decimal(14, 6)
  /// واحدِ قیمتِ فهرستی: USD | IRT — تا عددِ بی‌واحد ذخیره نشود.
  listPriceCurrency String?

  jobs   Job[]
  scores ModelScore[]
  calls  ProviderCall[]

  @@unique([providerId, modelKey])
  @@index([modality])
}

/// ثبت هر فراخوان درگاه — پایه داشبورد سلامت و ابزار مقایسه مدل‌ها.
///
/// 🔒 عمدا سبک است: **نه پرامپت ذخیره می‌شود، نه پاسخ، نه کلید**. فقط
/// نتیجه و زمان. هر چیز بیشتر یعنی محتوای کاربر در جدول لاگ نشت می‌کند و
/// پشتیبان‌گیری را هم بی‌دلیل سنگین می‌کند.
///
/// بدون این جدول، «نرخ خطای هر درگاه» عددی برای نشان دادن ندارد و انتخاب
/// مدل تا ابد بر پایه ادعای فروشنده می‌ماند.
model ProviderCall {
  id         String     @id @default(cuid())
  providerId String
  provider   AiProvider @relation(fields: [providerId], references: [id])
  modelId    String?
  model      AiModel?   @relation(fields: [modelId], references: [id])
  /// نوع گام از تاکسونومی بسته. برای مسیر متنی خالی می‌ماند.
  stepType   String?
  ok         Boolean
  httpStatus Int?
  /// دسته خطا، نه متن خام: timeout | http | shape | network | unknown.
  /// متن خام می‌تواند کلید یا محتوای کاربر را با خودش بیاورد.
  errorKind  String?
  latencyMs  Int
  createdAt  DateTime   @default(now())

  @@index([providerId, createdAt])
  @@index([ok, createdAt])
}

/// معیارِ انتخاب: **هزینه به‌ازای ثانیهٔ پذیرفته‌شده** (سندِ ۸۱).
/// مدلِ ارزانی که چهار بار تکرار می‌خواهد، از مدلِ گرانِ یک‌باره گران‌تر است.
///
/// ⛔ دروازهٔ شواهد — این جدول **مشتق** است و بازمحاسبه می‌شود:
///   • هرگز دستی نوشته نمی‌شود و هرگز از ادعای فروشنده پر نمی‌شود.
///   • تا `sampleSize >= 30` برایِ هر (مدل، نوعِ گام)، روتر حق ندارد به آن
///     نگاه کند. روترِ v1 فقط فیلترِ صلاحیت + قیمتِ فهرستی + failover است.
model ModelScore {
  id         String   @id @default(cuid())
  modelId    String
  model      AiModel  @relation(fields: [modelId], references: [id])
  stepType   String
  /// Σ هزینهٔ همهٔ تلاش‌ها ÷ Σ ثانیهٔ خروجیِ پذیرفته‌شده
  cpas       Decimal  @db.Decimal(14, 6)
  sampleSize Int
  computedAt DateTime @default(now())

  @@unique([modelId, stepType])
  @@index([stepType])
}

// ─── صف — جدول + قفلِ دیتابیسی (D-007)، بدونِ BullMQ ───

enum JobStatus {
  PENDING
  RUNNING
  DONE
  FAILED
}

/// یک گروه = یک خروجیِ قابلِ‌دیدنِ کاربر (docs/40 بندِ ۳، الزامِ ۳).
/// حتی یک شاتِ تکی هم یک JobGroup با یک Job می‌شود — از روزِ اول یکسان.
model JobGroup {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  // ─── وارونگیِ بودجه (سندِ ۸۱ بخشِ ۱۳) ───
  // مبلغی که کاربر پرداخت کرده **ورودیِ الگوریتم است، نه خروجیِ آن**.
  // پاکت پیش از اولین فراخوانِ پولی بسته می‌شود و پلان به‌عقب از آن ساخته
  // می‌شود. اگر پلان جا نشد، پیش از خرج‌کردن اعلام می‌شود — نه تنزلِ بی‌صدا.
  /// D-O14: واحد **سکه** و `Int` است، نه Decimal — دفتر هرگز اعشاری نمی‌شود.
  budgetCap      Int    @default(0)
  /// اعمال در سرور. اعمال در UI یعنی اعمال‌نشده (گاردریلِ ۳).
  spentAmount    Int    @default(0)
  /// سکه‌ای که رزرو شده ولی هنوز تسویه نشده. بدونِ این ستون، دو گامِ هم‌زمان
  /// هر دو «جا داریم» می‌بینند و پاکت از سقف رد می‌شود.
  /// شرطِ پاکت: `spentAmount + reservedAmount + مبلغِ تازه ≤ budgetCap`.
  reservedAmount Int    @default(0)
  /// سقفِ پله‌های نردبانِ تشدید. سیستم هرگز بی‌سقف بالا نمی‌رود.
  escalationCap  Int    @default(1)
  /// انتظارِ کاربر: draft | standard | hero
  qualityTier    String @default("standard")

  jobs      Job[]
  planSteps PlanStep[]
  holds     WalletHold[]

  @@index([userId])
}

/// گرافِ گام‌های قابلیت (L1ِ سندِ ۸۱) — نه یک فراخوان، نه یک قالبِ رشته‌ای.
/// ⚠️ با `AiRecipe`ِ وبکستینگ اشتباه نشود: آن قالبِ رشته‌ایِ تک‌گویشی است.
///
/// 🔀 واگرایی از سندِ ۸۱: سند `Shot.planId` را به PlanStep وصل می‌کرد؛ ولی
/// هر نما یک **زنجیره** از گام‌ها دارد نه یک گام، پس جهتِ رابطه برعکس شد:
/// `PlanStep.shotId`. با این کار زنجیرهٔ هر نما یک کوئری است، و گامِ مشترکِ
/// بینِ چند نما (مثلِ یک آپ‌اسکیلِ دسته‌ای) با `shotId = null` بیان می‌شود.
model PlanStep {
  id         String   @id @default(cuid())
  jobGroupId String
  jobGroup   JobGroup @relation(fields: [jobGroupId], references: [id])
  shotId     String?
  shot       Shot?    @relation(fields: [shotId], references: [id])
  /// نوعِ گام — روتر روی همین تصمیم می‌گیرد، نه رویِ نامِ مدل (گاردریلِ ۱).
  /// text2image | image2video | text2video | upscale | tts | lipsync |
  /// programmatic_motion | html2image
  capability String
  /// شناسهٔ گام‌هایی که باید پیش از این تمام شوند — گرافِ جهت‌دار.
  dependsOn  Json?
  orderIndex Int      @default(0)
  createdAt  DateTime @default(now())

  generations Generation[]

  @@index([jobGroupId])
  @@index([shotId])
}

model Job {
  id        String    @id @default(cuid())
  groupId   String
  group     JobGroup  @relation(fields: [groupId], references: [id])
  shotId    String
  shot      Shot      @relation(fields: [shotId], references: [id])
  aiModelId String
  aiModel   AiModel   @relation(fields: [aiModelId], references: [id])
  status    JobStatus @default(PENDING)
  /// قفلِ کرونِ کارگر: UPDATE Job SET lockedAt=now(),lockedBy=$1
  ///   WHERE status='PENDING' AND lockedAt IS NULL ... RETURNING *
  lockedAt  DateTime?
  lockedBy  String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  /// یک Job می‌تواند چند رکوردِ Generation داشته باشد (تلاش‌های مکرر) —
  /// عمداً یک‌به‌یک نیست (گاردریلِ منشورِ اجرا، ایرادِ شمارهٔ ۳).
  generations Generation[]

  @@index([groupId])
  @@index([status, lockedAt])
}

// ─── کدهایِ دلیل — تاکسونومیِ بسته، نه متنِ آزاد ───

/// تاکسونومی بسته دلیل — هم برای رد شدن یک خروجی، هم برای رد شدن یک
/// درخواست در دروازه انطباق، هم برای برداشتن یک اثر از یک مقصد. متن آزاد
/// نیست چون بعدا باید بشود شمرد و گزارش گرفت.
model ReasonCode {
  id       String @id @default(cuid())
  code     String @unique
  label    String
  /// quality | compliance | legal | technical
  category String

  generations      Generation[]
  complianceChecks ComplianceCheck[]
  publications     Publication[]
  comments         Comment[]
}

// ─── دفترِ ثبت — هر رکورد غیرقابلِ‌تغییر است ───

model Generation {
  id                String      @id @default(cuid())
  jobId             String
  job               Job         @relation(fields: [jobId], references: [id])
  shotId            String
  shot              Shot        @relation(fields: [shotId], references: [id])
  /// نسخهٔ دقیقِ مدل، به‌عنوانِ رشتهٔ منجمد — نه FK به AiModel
  /// (AiModel ممکن است فردا عوض شود؛ این رکورد نباید).
  modelVersion      String
  modelKeySnap      String
  seed              Int?
  paramHash         String
  /// فقط لینکِ آبجکت‌استوریج — هرگز بایتِ باینری در Postgres.
  resultUrl         String?
  resultHash        String?
  costActual        Int // سکه
  /// D-010: واترمارکِ متنی — نه بلوبِ Json، نه امضایِ واقعی.
  c2paWatermarkText String?
  humanApproval     Boolean?
  reasonCodeId      String?
  reasonCode        ReasonCode? @relation(fields: [reasonCodeId], references: [id])
  createdAt         DateTime    @default(now())

  // ─── ورودی‌های CPAS (سندِ ۸۱) ───
  // بدونِ این دو فیلد، «هزینه به‌ازای ثانیهٔ پذیرفته‌شده» محاسبه‌ناپذیر است:
  // برایِ مخرج باید بدانیم کدام تلاش پذیرفته شد، و برایِ صورت باید همهٔ
  // تلاش‌های ردشدهٔ همان زنجیره را جمع بزنیم. **حذف نشوند.**
  /// شمارهٔ تلاش در زنجیره — از ۱ شروع می‌شود.
  attemptIndex Int         @default(1)
  /// تلاشِ قبلی که این یکی جایگزینش شد.
  supersedesId String?     @unique
  supersedes   Generation? @relation("AttemptChain", fields: [supersedesId], references: [id])
  supersededBy Generation? @relation("AttemptChain")
  /// کدام گامِ پلان این خروجی را ساخت.
  planStepId   String?
  planStep     PlanStep?   @relation(fields: [planStepId], references: [id])

  @@index([jobId])
  @@index([shotId])
  @@index([planStepId])
}
